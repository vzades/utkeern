@page "/research"
@using System.Collections.Generic

<PageTitle>Research & Articles - Utkeern</PageTitle>

<section class="research-hero">
    <div class="research-hero-content">
        <h1>Research & Articles</h1>
        <p>Scholarly exploration of Indian heritage, culture, and historical narratives</p>
    </div>
</section>

<section class="content">
    <div class="container-sm">
        <SectionHeader Title="Latest Articles" />

        <div class="articles-grid">
            <article class="article-card">
                <div class="article-date">Jan 15, 2024</div>
                <h3>The Architectural Language of Indian Temples</h3>
                <div class="article-meta">
                    <span class="category-tag">Architecture</span>
                    <span class="read-time">8 min read</span>
                </div>
                <p>
                    Exploring how Indian temple architecture conveys spiritual, mathematical, and cultural knowledge 
                    through intricate design patterns, proportions, and symbolic elements. Understanding the deeper 
                    meaning behind architectural choices that have sustained for millennia.
                </p>
                <a href="#" class="btn btn-text">Read Article →</a>
            </article>

            <article class="article-card">
                <div class="article-date">Jan 8, 2024</div>
                <h3>Preservation Challenges in Digital Age</h3>
                <div class="article-meta">
                    <span class="category-tag">Preservation</span>
                    <span class="read-time">10 min read</span>
                </div>
                <p>
                    Examining the intersection of traditional heritage preservation and modern digital technologies. 
                    Discussing how digital archiving, 3D documentation, and online platforms are reshaping how we 
                    preserve and share cultural knowledge across generations.
                </p>
                <a href="#" class="btn btn-text">Read Article →</a>
            </article>

            <article class="article-card">
                <div class="article-date">Dec 28, 2023</div>
                <h3>Iconography in Indian Art: Symbols and Meanings</h3>
                <div class="article-meta">
                    <span class="category-tag">Art History</span>
                    <span class="read-time">12 min read</span>
                </div>
                <p>
                    A comprehensive guide to understanding the symbolic language of Indian art. From religious iconography 
                    to mythological narratives, this article explores how visual symbols communicate spiritual and philosophical 
                    concepts in sculpture, painting, and decorative arts.
                </p>
                <a href="#" class="btn btn-text">Read Article →</a>
            </article>

            <article class="article-card">
                <div class="article-date">Dec 15, 2023</div>
                <h3>Manuscripts as Living Documents of Knowledge</h3>
                <div class="article-meta">
                    <span class="category-tag">Manuscripts</span>
                    <span class="read-time">9 min read</span>
                </div>
                <p>
                    Investigating the role of ancient manuscripts in preserving Indian knowledge systems. From Sanskrit texts 
                    to palm leaf manuscripts, exploring how physical documents encode philosophy, science, mathematics, and 
                    the artistic achievements of ancient Indian civilization.
                </p>
                <a href="#" class="btn btn-text">Read Article →</a>
            </article>

            <article class="article-card">
                <div class="article-date">Dec 8, 2023</div>
                <h3>Sacred Spaces: Pilgrimage Routes and Spiritual Geography</h3>
                <div class="article-meta">
                    <span class="category-tag">Culture</span>
                    <span class="read-time">11 min read</span>
                </div>
                <p>
                    Understanding how geography, spirituality, and cultural traditions intersect in Indian pilgrimage sites. 
                    Examining how sacred routes like the Varanasi corridor create networks of meaning and cultural continuity 
                    that span centuries.
                </p>
                <a href="#" class="btn btn-text">Read Article →</a>
            </article>

            <article class="article-card">
                <div class="article-date">Nov 30, 2023</div>
                <h3>Musical Traditions: The Evolution of Indian Instruments</h3>
                <div class="article-meta">
                    <span class="category-tag">Music</span>
                    <span class="read-time">7 min read</span>
                </div>
                <p>
                    Tracing the development of classical Indian instruments from ancient times to modern era. Exploring how 
                    instruments embody mathematical principles, emotional expression, and philosophical concepts central to 
                    Indian aesthetic traditions.
                </p>
                <a href="#" class="btn btn-text">Read Article →</a>
            </article>
        </div>
    </div>
</section>

<div class="heritage-divider"></div>

<section class="content alt">
    <div class="container-sm">
        <SectionHeader Title="Research Resources" />
        
        <div class="resources-grid">
            <ResourceCard 
                Title="Bibliography" 
                Description="Curated list of scholarly references on Indian heritage and culture" 
                Icon="📚" />
            
            <ResourceCard 
                Title="Archives" 
                Description="Digital collections and databases for heritage research" 
                Icon="🗂️" />
            
            <ResourceCard 
                Title="Contributing" 
                Description="Guidelines for contributing research and articles to our platform" 
                Icon="✍️" />
        </div>
    </div>
</section>

