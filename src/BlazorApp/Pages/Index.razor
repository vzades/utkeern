@page "/"

<PageTitle>Home - Utkeern</PageTitle>

<section class="hero">
    <div class="hero-content">
        <h1>Utkeern</h1>

        <!-- Temple-inspired ornamental divider (animated heritage motif) -->
        <div class="heritage-motif"></div>

        <p class="hero-subtitle">Preserving the Legacy of Indian Heritage</p>
        <p class="hero-description">
            Discover the depth, beauty, and timelessness of Indian architecture, art, manuscripts, 
            instruments, and rituals. A visual archive celebrating knowledge, culture, and craftsmanship 
            through immersive storytelling and scholarly exploration.
        </p>

        <div class="hero-cta">
            <NavLink href="gallery" class="btn btn-primary">✨ Explore Gallery</NavLink>
            <NavLink href="about" class="btn btn-secondary">📖 Learn More</NavLink>
        </div>
    </div>
</section>

<section class="content alt">
    <div class="container-sm">
        <SectionHeader Title="Heritage Categories" />

        <div class="grid-3">
            <FeatureCard 
                Icon="🏛️" 
                Title="Sacred Architecture" 
                Description="Temples, mosques, churches, and spiritual landmarks showcasing India's architectural brilliance and spiritual traditions." />

            <FeatureCard 
                Icon="🎨" 
                Title="Arts & Manuscripts" 
                Description="Classical art forms, manuscripts, sculpture, and craftsmanship traditions preserved through centuries." />

            <FeatureCard 
                Icon="📚" 
                Title="Cultural Knowledge" 
                Description="Rituals, instruments, traditions, and philosophical heritage explored through visual storytelling and research." />
        </div>
    </div>
</section>

<div class="heritage-divider"></div>

<!-- Featured Heritage Highlights Section -->
<section class="content featured-highlights">
    <div class="container-sm">
        <div class="section-intro">
            <h2>Featured Collections</h2>
            <p class="section-subtitle">Curated selections of India's most significant heritage and cultural treasures</p>
        </div>

        <!-- Two-column alternating layout for visual richness -->
        <div class="featured-item">
            <div class="featured-image">
                <img src="images/design-desk.jpeg" alt="Indian Temple Architecture" class="featured-img" />
            </div>
            <div class="featured-text">
                <h3>Sacred Architecture</h3>
                <p class="featured-description">
                    From ancient temple complexes to medieval fortifications, explore the architectural evolution 
                    that shaped Indian civilization. Each structure reflects centuries of innovation, craftsmanship, 
                    and spiritual devotion.
                </p>
                <ul class="featured-list">
                    <li>Temple Architecture & Sacred Spaces</li>
                    <li>Forts & Palaces</li>
                    <li>Architectural Details & Ornaments</li>
                </ul>
                <NavLink href="gallery" class="btn btn-primary">Discover Architecture →</NavLink>
            </div>
        </div>

        <div class="featured-item reverse">
            <div class="featured-image">
                <img src="images/motion-background.jpg" alt="Indian Art and Culture" class="featured-img" />
            </div>
            <div class="featured-text">
                <h3>Art & Manuscripts</h3>
                <p class="featured-description">
                    Classical art forms, intricate manuscripts, and masterful sculptures tell stories of 
                    India's rich cultural expression. Witness the skill and vision of artisans across generations.
                </p>
                <ul class="featured-list">
                    <li>Classical Dance & Performance Arts</li>
                    <li>Illuminated Manuscripts & Scripts</li>
                    <li>Sculpture & Decorative Arts</li>
                </ul>
                <NavLink href="gallery" class="btn btn-primary">Explore Arts →</NavLink>
            </div>
        </div>
    </div>
</section>

<section class="content alt">
    <div class="container">
        <SectionHeader Title="Quick Access" />

        <div class="grid-4">
            <QuickAccessCard Title="Gallery" Icon="🖼️" Link="gallery" />
            <QuickAccessCard Title="Projects" Icon="💼" Link="projects" />
            <QuickAccessCard Title="Research" Icon="📖" Link="research" />
            <QuickAccessCard Title="About" Icon="👤" Link="about" />
        </div>
    </div>
</section>

