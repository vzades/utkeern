@page "/"

<PageTitle>Home - Utkeern</PageTitle>

<section class="hero">
    <div class="hero-content">
        <h1>Utkeern</h1>

        <!-- Temple-inspired ornamental divider (animated heritage motif) -->
        <div class="heritage-motif"></div>

        <p class="hero-subtitle">Preserving the Legacy of Indian Heritage</p>
        <p class="hero-description">
            Discover the depth, beauty, and timelessness of Indian architecture.A visual archive celebrating knowledge, culture, and craftsmanship
            through immersive storytelling and scholarly exploration.
        </p>
    </div>
</section>

<section class="content alt">
    <div class="container-sm">
        <SectionHeader Title="Heritage Categories" />

        <div class="grid-3">
            <FeatureCard 
                Icon="landmark"
                Title="Sacred Architecture" 
                Description="Temples, mosques, churches, and spiritual landmarks showcasing India's architectural brilliance and spiritual traditions." />

            <FeatureCard 
                Icon="scroll-text"
                Title="Arts & Inscription" 
                Description="Classical art forms, Inscription, sculpture, and craftsmanship traditions preserved through centuries." />

            <FeatureCard 
                Icon="library"
                Title="Cultural Knowledge" 
                Description="Traditions, and philosophical heritage explored through visual storytelling and research." />
        </div>
    </div>
</section>

<div class="heritage-divider"></div>

<!-- Featured Heritage Highlights Section -->
<section class="content featured-highlights">
    <div class="container-sm">
        <div class="section-intro">
            <h2>Featured Collections</h2>
        
        </div>

        <!-- Two-column alternating layout for visual richness -->
        <div class="featured-item">
            <div class="featured-image">
                <img src="images/Arch Home Page.webp" alt="Indian Temple Architecture" class="featured-img" />
            </div>
            <div class="featured-text">
                <h3>Sacred Architecture</h3>
                <p class="featured-description">
                    From ancient temple complexes to medieval fortifications, explore the architectural evolution 
                    that shaped Indian civilization. Each structure reflects centuries of innovation, craftsmanship, 
                    and spiritual devotion.
                </p>
                <ul class="featured-list">
                    <li>Temple Architecture & Sacred Spaces</li>
                    <li>Forts & Palaces</li>
                    <li>Architectural Details & Ornaments</li>
                </ul>
                <NavLink href="gallery" class="btn btn-primary">
                    Discover Architecture
                    <AppIcon Name="chevron-right" CssClass="button-icon" />
                </NavLink>
            </div>
        </div>

        <div class="featured-item reverse">
            <div class="featured-image">
                <img src="images/Sculp home page.webp" alt="Indian Art and Culture" class="featured-img" />
            </div>
            <div class="featured-text">
                <h3>Art &  sculptures</h3>
                <p class="featured-description">
                    Classical art forms, intricate manuscripts, and masterful sculptures tell stories of 
                    India's rich cultural expression. Witness the skill and vision of artisans across generations.
                </p>
                <ul class="featured-list">
                    <li>Illuminated Inscription & Scripts</li>
                    <li>Sculpture & Decorative Arts</li>
                </ul>
                <NavLink href="gallery" class="btn btn-primary">
                    Explore Arts
                    <AppIcon Name="chevron-right" CssClass="button-icon" />
                </NavLink>
            </div>
        </div>
    </div>
</section>

<section class="content alt">
    <div class="container">
        <SectionHeader Title="Quick Access" />

        <div class="grid-4">
            <QuickAccessCard Title="Gallery" Icon="images" Link="gallery" />
            <QuickAccessCard Title="Projects" Icon="briefcase" Link="projects" />
            <QuickAccessCard Title="Research" Icon="flask" Link="research" />
            <QuickAccessCard Title="About" Icon="info" Link="about" />
        </div>
    </div>
</section>

