@page "/gallery"
@using System.Collections.Generic
@using System.Linq

<PageTitle>Heritage Gallery - Utkeern</PageTitle>

<section class="gallery-hero">
    <div class="gallery-hero-content">
        <h1>Heritage Gallery</h1>
        <p class="gallery-hero-subtitle">Explore India's Most Significant Cultural Treasures</p>
        <p class="gallery-hero-description">
            A carefully curated visual archive of architectural marvels, sacred spaces, artistic masterpieces, 
            and cultural landmarks that define India's rich heritage. Each image tells a story of craftsmanship, 
            devotion, and historical significance.
        </p>
    </div>
</section>

<section class="content">
    <div class="container">
        <div class="gallery-header">
            <div class="gallery-intro">
                <SectionHeader Title="Browse Our Collections" />
                <p class="collection-intro">Select a category to explore specific aspects of Indian heritage</p>
            </div>

            <div class="filter-section">
                <div class="filter-labels">
                    <h4>Filter by Category</h4>
                    <p class="filter-help">Click a category to view related heritage items</p>
                </div>
                <div class="filter-buttons">
                    <button class="filter-btn @(selectedCategory == "all" ? "active" : "")" 
                            @onclick="@((MouseEventArgs e) => FilterByCategory("all"))"
                            title="View all heritage items">
                        <AppIcon Name="archive" CssClass="filter-icon" />
                        All Collections
                    </button>
                    <button class="filter-btn @(selectedCategory == "architecture" ? "active" : "")" 
                            @onclick="@((MouseEventArgs e) => FilterByCategory("architecture"))"
                            title="View architectural heritage">
                        <AppIcon Name="landmark" CssClass="filter-icon" />
                        Architecture
                    </button>
                    <button class="filter-btn @(selectedCategory == "art" ? "active" : "")" 
                            @onclick="@((MouseEventArgs e) => FilterByCategory("art"))"
                            title="View art and sculpture">
                        <AppIcon Name="palette" CssClass="filter-icon" />
                        Art & Sculpture
                    </button>
                    <button class="filter-btn @(selectedCategory == "manuscripts" ? "active" : "")" 
                            @onclick="@((MouseEventArgs e) => FilterByCategory("manuscripts"))"
                            title="View manuscripts">
                        <AppIcon Name="scroll-text" CssClass="filter-icon" />
                        Manuscripts
                    </button>
                    <button class="filter-btn @(selectedCategory == "instruments" ? "active" : "")" 
                            @onclick="@((MouseEventArgs e) => FilterByCategory("instruments"))"
                            title="View musical instruments">
                        <AppIcon Name="music" CssClass="filter-icon" />
                        Instruments
                    </button>
                    <button class="filter-btn @(selectedCategory == "rituals" ? "active" : "")" 
                            @onclick="@((MouseEventArgs e) => FilterByCategory("rituals"))"
                            title="View rituals and traditions">
                        <AppIcon Name="sparkles" CssClass="filter-icon" />
                        Rituals
                    </button>
                </div>
            </div>
        </div>

        <div class="gallery-stats">
            <span class="stat-item">
                <span class="stat-number">@filteredImages.Count</span>
                <span class="stat-label">@(filteredImages.Count == 1 ? "Item" : "Items") shown</span>
            </span>
        </div>

        <div class="gallery-grid">
            @foreach (var image in filteredImages)
            {
                <ImageCard 
                    Title="@image.Title" 
                    Description="@image.Description" 
                    Category="@image.Category"
                    ImageUrl="@image.ImageUrl" />
            }
        </div>

        @if (!filteredImages.Any())
        {
            <div class="empty-state">
                <div class="empty-icon icon-container">
                    <AppIcon Name="search" />
                </div>
                <p class="empty-title">No items found</p>
                <p>No images found in this category. Please try a different filter or browse <NavLink href="gallery">all collections</NavLink>.</p>
            </div>
        }
    </div>
</section>

@code {
    private string selectedCategory = "all";
    private List<HeritageImage> images = new();
    private List<HeritageImage> filteredImages = new();

    protected override void OnInitialized()
    {
        // Sample data - In production, this would come from an API or JSON file
        images = new List<HeritageImage>
        {
            new HeritageImage 
            { 
                Title = "Taj Mahal", 
                Description = "A symbol of eternal love, built by Emperor Shah Jahan",
                Category = "architecture",
                ImageUrl = "images/design-desk.jpeg"
            },
            new HeritageImage 
            { 
                Title = "Classical Sculpture", 
                Description = "Ancient Indian sculptural mastery",
                Category = "art",
                ImageUrl = "images/design-desk.jpeg"
            },
            new HeritageImage 
            { 
                Title = "Sanskrit Manuscript", 
                Description = "Ancient Sanskrit texts preserved through centuries",
                Category = "manuscripts",
                ImageUrl = "images/design-desk.jpeg"
            },
            new HeritageImage 
            { 
                Title = "Sitar", 
                Description = "Traditional Indian stringed instrument",
                Category = "instruments",
                ImageUrl = "images/design-desk.jpeg"
            },
            new HeritageImage 
            { 
                Title = "Temple Ritual", 
                Description = "Sacred ceremonies and spiritual traditions",
                Category = "rituals",
                ImageUrl = "images/design-desk.jpeg"
            },
            new HeritageImage 
            { 
                Title = "Varanasi Temples", 
                Description = "Spiritual heart of Hindu pilgrimage",
                Category = "architecture",
                ImageUrl = "images/design-desk.jpeg"
            }
        };

        ApplyFilter();
    }

    private void FilterByCategory(string category)
    {
        selectedCategory = category;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (selectedCategory == "all")
        {
            filteredImages = images;
        }
        else
        {
            filteredImages = images.Where(i => i.Category == selectedCategory).ToList();
        }
    }

    public class HeritageImage
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
    }
}
