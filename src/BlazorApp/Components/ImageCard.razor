<article class="image-card @(LargeVariant ? "image-card-large" : "")">
    <a class="image-card-link"
       href="@FullImageUrl"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Open @Title image in a new tab">
        <div class="image-card-image">
            <img src="@ImageUrl"
                 alt="@Title"
                 loading="lazy"
                 decoding="async" />
            <div class="image-card-overlay">
                <h3>@Title</h3>
                @if (HasSecondaryLine)
                {
                    <p class="image-card-line">@SecondaryLine</p>
                }
                @if (HasEraLine)
                {
                    <p class="image-card-line image-card-era">@EraLine</p>
                }
            </div>
        </div>
    </a>
    <div class="image-card-metadata">
        @if (!string.IsNullOrEmpty(Category))
        {
            <span class="image-card-category">@Category</span>
        }
    </div>
</article>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string SubTitle { get; set; } = string.Empty;

    [Parameter]
    public string Location { get; set; } = string.Empty;

    [Parameter]
    public string Period { get; set; } = string.Empty;

    [Parameter]
    public string Dynasty { get; set; } = string.Empty;

    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Parameter]
    public string ImageUrl { get; set; } = string.Empty;

    [Parameter]
    public string FullImageUrl { get; set; } = string.Empty;

    [Parameter]
    public bool LargeVariant { get; set; } = false;

    private bool HasSecondaryLine =>
        !string.IsNullOrWhiteSpace(SubTitle) ||
        !string.IsNullOrWhiteSpace(Location);

    private bool HasEraLine =>
        !string.IsNullOrWhiteSpace(Period) ||
        !string.IsNullOrWhiteSpace(Dynasty);

    private string SecondaryLine =>
        string.Join(", ", new[] { SubTitle, Location }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string EraLine =>
        string.Join(", ", new[] { Period, Dynasty }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
