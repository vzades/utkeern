<article class="image-card @(LargeVariant ? "image-card-large" : "")">
    <a class="image-card-link"
       href="@FullImageUrl"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Open @Title image in a new tab">
        <div class="image-card-image">
            <img src="@ImageUrl"
                 alt="@Title"
                 loading="lazy"
                 decoding="async" />
            <div class="image-card-overlay">
                <h3>@Title</h3>
                <p>@SubTitle</p>
            </div>
        </div>
    </a>
    <div class="image-card-metadata">
        @if (!string.IsNullOrEmpty(Category))
        {
            <span class="image-card-category">@Category</span>
        }
    </div>
</article>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string SubTitle { get; set; } = string.Empty;

    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Parameter]
    public string ImageUrl { get; set; } = string.Empty;

    [Parameter]
    public string FullImageUrl { get; set; } = string.Empty;

    [Parameter]
    public bool LargeVariant { get; set; } = false;
}
