<div class="card feature-card">
    <div class="icon-container feature-icon">
        <AppIcon Name="@Icon" />
    </div>
    <h3>@Title</h3>
    <p>@Description</p>
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;
}
